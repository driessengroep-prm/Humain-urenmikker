# --- Buddy Data ---------------------------------------------
# Staan deze drie ingevuld, dan bewaart de Urenmikker zijn use
# cases in Buddy Data en zien collega's elkaars wijzigingen.
# Laat ze leeg voor een lokale demo: dan leest de app
# use-cases.json en blijft alles in het geheugen.
#
# De medewerker logt in met zijn gewone Buddy-account; er is
# geen aparte inlog en er staat geen sleutel in deze app.
VITE_BUDDY_URL=http://localhost:5000
VITE_BUDDY_DATA_URL=http://localhost:5010
VITE_BUDDY_PROJECT=urenmikker

# --- Rekeninstellingen (optioneel) --------------------------
# VITE_JAARDOEL_UREN=10000
# VITE_WERKWEKEN=46
# VITE_TELMODUS=alleen-done
