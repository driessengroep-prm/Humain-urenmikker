# --- Buddy Data ---------------------------------------------
# Staan deze vijf ingevuld, dan bewaart de Urenmikker zijn use
# cases in Buddy Data en zien collega's elkaars wijzigingen.
# Laat ze leeg voor een lokale demo: dan leest de app
# use-cases.json en blijft alles in het geheugen.
#
# Alles of niets: met de helft vraagt de app om een login die
# nergens heen gaat.
VITE_BUDDY_URL=https://buddy.driessengroep.nl
VITE_BUDDY_DATA_URL=https://buddy.driessengroep.nl/data
VITE_BUDDY_PROJECT=urenmikker

# --- Inloggen met je Driessen-account -----------------------
# De app-registratie in Entra. Geen geheimen: dit zijn openbare
# identificatoren. Er hoort wel een redirect-URI in die
# registratie te staan voor het adres waar deze app draait.
VITE_ENTRA_CLIENT_ID=502ee1d7-2c20-4770-b3e3-b2a9ddbfccfc
VITE_ENTRA_TENANT_ID=67052f8b-2d27-450e-a658-59143add5525

# --- Rekeninstellingen (optioneel) --------------------------
# VITE_JAARDOEL_UREN=10000
# VITE_WERKWEKEN=46
# VITE_TELMODUS=alleen-done
